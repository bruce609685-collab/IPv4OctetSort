/* IPv4OctetSort 资源脚本：manifest / 加速键 / 关于对话框 / 版本信息
 *
 * 说明：
 *   · 图标暂缺（文档 TBD-2：使用系统默认图标），因此本文件不含 ICON 语句；
 *   · 菜单自 v0.3 起由 src/ui/menu_bar.cpp 代码构建（多语言 + 自绘，FR-11），
 *     本文件不再包含 MENU 资源；
 *   · 加速键与对话框中的命令 ID 必须与 src/ui/control_ids.h 保持一致；
 *   · 源文件为 UTF-8，编译时须指定代码页：windres --codepage=65001（见 build/build.bat）；
 *   · 样式常量在本文件内自定义，不依赖编译器附带头文件。
 */

#include "../app/app_info.h"

/* ---- 资源与命令 ID（与 src/ui/control_ids.h 同步） ---- */
/* VS_VERSION_INFO 必须展开为数字 1（winver.h 约定，本文件不依赖编译器头文件）。
 * 裸标识符会被 windres 当作字符串资源名，GetFileVersionInfo 只认 ID=1，
 * Explorer 文件属性与 FileVersionInfo 将读不到任何版本信息。 */
#define VS_VERSION_INFO  1

#define IDD_ABOUT        101
#define IDR_ACCEL        102

#define IDM_CLEAR        2001
#define IDM_PASTE_HINT   2002
#define IDM_EXIT         2003
#define IDM_COPY_RESULT  2004
#define IDM_COPY_GAPS    2005
#define IDM_ASC          2006
#define IDM_DESC         2007
#define IDM_ABOUT        2009

#define IDC_ABOUT_NAME_CN 3001
#define IDC_ABOUT_NAME_EN 3002
#define IDC_ABOUT_VERSION 3003
#define IDC_ABOUT_DATE    3004
/* 左侧字段标签（v0.3 起随语言切换，见 about_dialog.cpp） */
#define IDC_ABOUT_LBL_CN  3011
#define IDC_ABOUT_LBL_EN  3012
#define IDC_ABOUT_LBL_VER 3013
#define IDC_ABOUT_LBL_DATE 3014

/* ---- 样式常量 ---- */
#define DS_MODALFRAME    0x80L
#define DS_CENTER        0x0800L
#define DS_SETFONT       0x40L
#define WS_POPUP         0x80000000L
#define WS_CAPTION       0x00C00000L
#define WS_SYSMENU       0x00080000L
#define IDOK             1
#define IDC_STATIC       (-1)

/* ---- 应用程序清单（comctl32 v6 / DPI 感知 / 支持的系统） ---- */
1 24 "app.manifest"

/* ---- 加速键（仅在输入框未获得焦点时生效，见 ui/main_window.cpp） ---- */
IDR_ACCEL ACCELERATORS
BEGIN
    "D", IDM_CLEAR, VIRTKEY, CONTROL
    "C", IDM_COPY_RESULT, VIRTKEY, CONTROL
END

/* ---- 关于对话框（FR-10，模态） ---- */
IDD_ABOUT DIALOGEX 0, 0, 258, 122
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 IPv4OctetSort"
FONT 9, "Microsoft YaHei", 400, 0, 1
BEGIN
    LTEXT           "程序名称", IDC_ABOUT_LBL_CN, 12, 16, 52, 10
    LTEXT           "—", IDC_ABOUT_NAME_CN, 68, 16, 178, 10
    LTEXT           "英文名称", IDC_ABOUT_LBL_EN, 12, 32, 52, 10
    LTEXT           "—", IDC_ABOUT_NAME_EN, 68, 32, 178, 10
    LTEXT           "版本", IDC_ABOUT_LBL_VER, 12, 48, 52, 10
    LTEXT           "—", IDC_ABOUT_VERSION, 68, 48, 178, 10
    LTEXT           "构建日期", IDC_ABOUT_LBL_DATE, 12, 64, 52, 10
    LTEXT           "—", IDC_ABOUT_DATE, 68, 64, 178, 10
    DEFPUSHBUTTON   "确定", IDOK, 196, 96, 50, 14
END

/* ---- 版本信息（文档 §9：不写入作者字段） ---- */
VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_CSV
PRODUCTVERSION APP_VERSION_CSV
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "IPv4网络地址排序器"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "IPv4OctetSort"
            VALUE "OriginalFilename", "IPv4OctetSort.exe"
            VALUE "ProductName", "IPv4OctetSort"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

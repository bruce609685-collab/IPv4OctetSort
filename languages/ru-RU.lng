# ============================================================
#  IPv4OctetSort language pack: Russian (Russia)
#  Описание формата: docs/语言包制作说明.md
#  Пробелы в начале и конце значения удаляются; разделители
#  задаются в самих строках формата. Экранирование: \t \n \r \\
# ============================================================

locale = ru-RU
name = Русский

# ---- Главное окно ----
WindowTitle = IPv4OctetSort — Сортировщик адресов IPv4
StartupError = Ошибка запуска: не удалось создать главное окно.

# ---- Строка меню ----
MenuFile = &Файл
MenuClear = &Очистить ввод\tCtrl+D
MenuPaste = &Вставить в поле ввода\tCtrl+V
MenuExit = &Выход\tAlt+F4
MenuEdit = &Правка
MenuCopy = &Копировать результат\tCtrl+C
MenuCopyGaps = Копировать только &свободные адреса
MenuView = &Вид
MenuAsc = По &возрастанию
MenuDesc = По &убыванию
MenuAbout = &О программе

# ---- Панель инструментов ----
BtnAsc = Возрастание
BtnDesc = Убывание
SegLabel = Октет:
ChkDedupe = Без дубликатов
ChkFill = Пропуски
BtnUpdate = Обновления
LangArrow = ▼

# ---- Панель ввода ----
InputTitle = Ввод
BtnClear = Очистить
StatEntries = Адресов: %d
StatUnrecognized = Не распознано: %d
StatMerged = дубликаты объединены
InputHint = Вставьте адреса, по одному в строке; также можно через запятую или пробел
FaultFmt = Строка %d · %s — %s
FaultMore = ещё %d не показано

# ---- Причины отклонения (core::ReasonKind; %d = номер октета) ----
ReasonFormat = не является IPv4-адресом в десятичной записи с точками
ReasonOctetFmt = октет %d вне диапазона 0-255
ReasonPrefix = длина префикса вне диапазона 0-32

# ---- Пояснение различающегося октета (FR-3.4; фраза собирается в i18n.cpp) ----
HintNoDiff = Все четыре октета совпадают, отличающегося октета нет; заполнение выполняется по октету D
HintIdentOne = Октет %s
HintIdentMany = Октеты %s
HintJoinSep = ,\x20
HintMulti = %s совпадают; октет %s имеет несколько значений (%s), сортировка возможна только по октету %s
DiffMore = из %d значений

# ---- Строка состояния и подсказки ----
StReady = Готово
StReadyPending = Готово · ожидание сортировки
StFilledPre = Заполнено (
StSortedPre = Отсортировано (
StClose = )
FmtSlots = Адресов: %d · свободно: %d
FmtTotal = Всего: %d
BySegFmt = по октету %s
SegDash = Октет: -
SegNone = Октет: без различий
SegFmt = Октет: %s
MsgCleared = Ввод очищен
MsgCopied = Результат скопирован в буфер обмена
MsgNeedFill = Сначала включите «Заполнить пропуски», затем копируйте свободные адреса
MsgNoGaps = Нет свободных адресов
MsgCopiedGaps = Скопировано свободных адресов: %d
MsgPasteFocus = Поле ввода активно — нажмите Ctrl+V для вставки
DirAsc = по возрастанию
DirDesc = по убыванию

# ---- Панель результата ----
ResultTitle = Результат
BtnCopy = Копировать результат
CopyMsg = Скопировано
ColAddress = Адрес
ColSequence = Полная последовательность
ColYourList = Ваш список
FmtPanelFill = Строк: %d · свободно: %d · %s
FmtPanelPlain = Адресов: %d · %s
EmptyHintA = Нажмите «
EmptyHintB = » или «
EmptyHintC = », чтобы начать.
GapText = Свободный IP-адрес
NoticeFmt = Заполнение по текущему октету требует %d адресов — это больше лимита 8 192, поэтому выполнен вывод простым списком. Сократите ввод до меньшего числа подсетей, чтобы включить заполнение.

# ---- Диалог «О программе» ----
AboutCaption = О программе IPv4OctetSort
AboutNameCn = Китайское название
AboutNameEn = Английское название
AboutVersion = Версия
AboutDate = Дата сборки
AboutOk = ОК
